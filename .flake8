[flake8]
max-line-length = 120
exclude =
    .git,
    __pycache__,
    */migrations/*,
    venv,
    env
ignore =
    E126,
    E303,
    E402,
    E722,
    F401,
    F541,
    F811,
    W291,
    C901
# Комментарии должны быть на отдельной строке, а не в конце строки с кодами ошибок
per-file-ignores =
    __init__.py:F401,F403,F811